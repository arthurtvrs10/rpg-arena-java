meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}",
    "displayName": "{{displayName}}"
  }
}

tests {
  test("cadastro retorna 201 ou conflito conhecido", function () {
    expect([201, 409]).to.include(res.status);
  });
  test("resposta nunca expõe senha", function () {
    expect(JSON.stringify(res.body)).not.to.include("passwordHash");
  });
}
